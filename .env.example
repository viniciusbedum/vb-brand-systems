# ─────────────────────────────────────────────────────────────
# MODO DEMO (padrão): deixe tudo vazio. Sem banco, sem login —
# o visitante navega pelos docs e assets de exemplo.
# ─────────────────────────────────────────────────────────────

# === Supabase — ativa o modo completo (login, membros, upload de assets) ===
# Crie um projeto em supabase.com e aplique supabase/migrations
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Força o modo demo mesmo com Supabase configurado
# NEXT_PUBLIC_DEMO_MODE=true

# === App ===
NEXT_PUBLIC_APP_URL=http://localhost:3000

# === IA — chat da home ===
# A interface aparece sempre. Para responder de verdade: modo completo + OPENROUTER_API_KEY.
# No modo demo o chat responde com um aviso. Para esconder o chat por completo:
# NEXT_PUBLIC_AI_ENABLED=false
# Qualquer modelo compatível com a API da OpenAI via OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-27b-it
