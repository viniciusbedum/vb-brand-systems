# Copy this file to .env.local and fill what you need. Never commit .env.local.
#
# DEMO MODE (default): leave everything empty. No database, no login —
# you browse the docs and the sample assets. Run `npm run dev` and open http://localhost:3000.

# ── Supabase: turns on FULL MODE (login, members, uploads, chat history) ──
# 1. Create a project at supabase.com  2. Apply supabase/migrations/*.sql  3. Copy these two
#    values from Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Needed ONLY to delete a member's login account (Settings > Members > Delete).
# Project Settings > API > service_role. Keep it secret; never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Public sign-up page (/signup). Off by default: create the first admin in the Supabase dashboard
# (Authentication > Users > Add user) and invite everyone else from there.
# NEXT_PUBLIC_SIGNUP_ENABLED=true

# Force demo mode even with Supabase configured.
# NEXT_PUBLIC_DEMO_MODE=true

# ── AI chat on the home page ──
# The chat answers questions using the pages in content/. It needs FULL MODE plus ONE provider key.
# Without a key, the chat shows a notice. To hide the chat entirely: NEXT_PUBLIC_AI_ENABLED=false
#
# Pick one provider (default: anthropic):
AI_PROVIDER=anthropic

#   anthropic -> Claude (console.anthropic.com)
ANTHROPIC_API_KEY=
#   openai    -> OpenAI (platform.openai.com)
# OPENAI_API_KEY=
#   gemini    -> Gemini and Gemma, with a free tier (aistudio.google.com)
# GEMINI_API_KEY=

# Optional: use another model of the chosen provider.
# Defaults: anthropic = claude-opus-5-5 (cheaper: claude-haiku-5-5), openai = gpt-5, gemini = gemma-3-27b-it
# AI_MODEL=

# ── Sharing on your local network (optional) ──
# Comma-separated addresses that will open the dev server from other devices, e.g. 192.168.1.20
# ALLOWED_DEV_ORIGINS=
